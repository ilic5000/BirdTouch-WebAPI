# Copy to .env and adjust. Used by docker compose and when running the API locally.
# IMPORTANT: on a real server, change all passwords and JWT_SECRET_KEY.

# --- PostgreSQL (used by both the database container and the API) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=birdtouch123
POSTGRES_DB=birdtouch
# Where the API finds the database when it runs outside docker. docker compose publishes the
# database on POSTGRES_PORT; inside docker the API always uses birdtouch-db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
# Port on which docker compose publishes the API.
API_PORT=4050
LOG_LEVEL=INFO

# Key for signing login tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-key-replace-me-0123456789
JWT_LIFETIME_DAYS=30

# Maximum size of an uploaded profile picture, in bytes (5 MB).
MAX_PICTURE_BYTES=5242880

# Users who stop reporting their location are hidden from others.
REMOVE_INACTIVE_USERS_RUN_EVERY_MINUTES=5
REMOVE_INACTIVE_USERS_OLDER_THAN_HOURS=24

# --- pgAdmin (http://localhost:9090) ---
PGADMIN_DEFAULT_EMAIL=pgadmin@birdtouch.rs
PGADMIN_DEFAULT_PASSWORD=birdtouch123
PGADMIN_LISTEN_PORT=9090
